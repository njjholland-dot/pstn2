{
  "name": "@pstn2/core",
  "version": "1.1.0",
  "description": "PSTN2 TypeScript SDK (protocol v1.1): Number Discovery, caller ID verification, direct routing and emergency location for Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "docs": "typedoc --out docs src/index.ts",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json",
    "example:01": "ts-node -P examples/tsconfig.json examples/01-basic-authentication.ts",
    "example:02": "ts-node -P examples/tsconfig.json examples/02-direct-routing.ts",
    "example:03": "ts-node -P examples/tsconfig.json examples/03-token-pool.ts",
    "example:04": "ts-node -P examples/tsconfig.json examples/04-emergency-services.ts",
    "example:05": "ts-node -P examples/tsconfig.json examples/05-complete-call-flow.ts",
    "example:06": "ts-node -P examples/tsconfig.json examples/06-number-discovery.ts",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration"
  },
  "keywords": [
    "pstn",
    "pstn2",
    "telecommunications",
    "voip",
    "sip",
    "distributed",
    "authentication",
    "fraud-prevention",
    "encryption",
    "direct-routing",
    "number-discovery"
  ],
  "author": "Nick Holland <nick.holland@8x8.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/njjholland-dot/pstn2.git",
    "directory": "code/typescript"
  },
  "bugs": {
    "url": "https://github.com/njjholland-dot/pstn2/issues"
  },
  "homepage": "https://pstn2.org",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
