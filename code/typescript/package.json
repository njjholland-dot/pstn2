{
  "name": "@pstn2/core",
  "version": "1.0.0",
  "description": "PSTN2 distributed telecommunications library for Node.js/TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "docs": "typedoc --out docs src/index.ts"
  },
  "keywords": [
    "pstn",
    "pstn2",
    "telecommunications",
    "voip",
    "sip",
    "distributed",
    "authentication",
    "fraud-prevention",
    "encryption",
    "direct-routing"
  ],
  "author": "Nick Holland <nick.holland@8x8.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pstn2/pstn2.git",
    "directory": "code/typescript"
  },
  "bugs": {
    "url": "https://github.com/pstn2/pstn2/issues"
  },
  "homepage": "https://pstn2.org",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "axios-retry": "^4.0.0",
    "crypto": "^1.0.1",
    "joi": "^17.11.0",
    "redis": "^4.6.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
