/**
 * PSTN2 Test Harness - Integration Tests
 *
 * Tests all supported use cases:
 * 1. Direct Query Authentication (CP1 → CP2)
 * 2. Token Pool Authentication (CP1 → CP3)
 * 3. Number Porting Chain Resolution
 * 4. Directory Lookup and Caching
 * 5. Direct Routing Negotiation
 * 6. Cross-CP Authentication with Porting
 * 7. Message Logging and Audit Trail
 */

import axios from 'axios';

// Test configuration
const BASE_URL = 'http://localhost:3000';
const CP1_URL = 'http://localhost:3001';
const CP2_URL = 'http://localhost:3002';
const CP3_URL = 'http://localhost:3003';

interface TestResult {
  name: string;
  passed: boolean;
  error?: string;
  duration?: number;
}

const results: TestResult[] = [];

// Helper function to log test results
function logTest(name: string, passed: boolean, error?: string, duration?: number) {
  results.push({ name, passed, error, duration });
  const status = passed ? '✅ PASS' : '❌ FAIL';
  console.log(`${status}: ${name}${duration ? ` (${duration}ms)` : ''}`);
  if (error) {
    console.log(`   Error: ${error}`);
  }
}

// Test 1: Health Checks
async function testHealthChecks() {
  const start = Date.now();
  try {
    const [sim, cp1, cp2, cp3] = await Promise.all([
      axios.get(`${BASE_URL}/health`),
      axios.get(`${CP1_URL}/health`),
      axios.get(`${CP2_URL}/health`),
      axios.get(`${CP3_URL}/health`)
    ]);

    const allHealthy =
      sim.data.status === 'healthy' &&
      cp1.data.status === 'healthy' &&
      cp2.data.status === 'healthy' &&
      cp3.data.status === 'healthy';

    logTest('Test 1: Health Checks - All Services', allHealthy, undefined, Date.now() - start);
  } catch (error: any) {
    logTest('Test 1: Health Checks - All Services', false, error.message);
  }
}

// Test 2: CP Info Endpoints
async function testCPInfo() {
  const start = Date.now();
  try {
    const [cp1, cp2, cp3] = await Promise.all([
      axios.get(`${CP1_URL}/pstn2/v1/info`),
      axios.get(`${CP2_URL}/pstn2/v1/info`),
      axios.get(`${CP3_URL}/pstn2/v1/info`)
    ]);

    const cp1Valid =
      cp1.data.cpId === 'CP1-UK-0001' &&
      cp1.data.authMode === 'direct_query' &&
      Array.isArray(cp1.data.numberRanges);

    const cp2Valid =
      cp2.data.cpId === 'CP2-UK-0002' &&
      cp2.data.authMode === 'direct_query';

    const cp3Valid =
      cp3.data.cpId === 'CP3-UK-0003' &&
      cp3.data.authMode === 'token_pool';

    logTest('Test 2: CP Info - CP1 (Direct Query)', cp1Valid, undefined, Date.now() - start);
    logTest('Test 2: CP Info - CP2 (Direct Query)', cp2Valid);
    logTest('Test 2: CP Info - CP3 (Token Pool)', cp3Valid);
  } catch (error: any) {
    logTest('Test 2: CP Info Endpoints', false, error.message);
  }
}

// Test 3: Directory Query
async function testDirectoryQuery() {
  const start = Date.now();
  try {
    // Query CP1 for a number it owns
    const response = await axios.post(`${CP1_URL}/pstn2/v1/directory/query`, {
      number: '+441712345000'
    });

    const valid = response.data.found === true;
    logTest('Test 3: Directory Query - Own Number', valid, undefined, Date.now() - start);
  } catch (error: any) {
    logTest('Test 3: Directory Query - Own Number', false, error.message);
  }
}

// Test 4: Directory Query - Not Found
async function testDirectoryQueryNotFound() {
  const start = Date.now();
  try {
    // Query CP1 for a number it doesn't own
    const response = await axios.post(`${CP1_URL}/pstn2/v1/directory/query`, {
      number: '+441770090000'
    });

    const valid = response.data.found === false;
    logTest('Test 4: Directory Query - Number Not Owned', valid, undefined, Date.now() - start);
  } catch (error: any) {
    logTest('Test 4: Directory Query - Number Not Owned', false, error.message);
  }
}

// Test 5: Directory Publish
async function testDirectoryPublish() {
  const start = Date.now();
  try {
    const response = await axios.get(`${CP1_URL}/pstn2/v1/directory/all`);

    const valid = Array.isArray(response.data.ranges) && response.data.ranges.length > 0;
    logTest('Test 5: Directory Publish - Get All Ranges', valid, undefined, Date.now() - start);
  } catch (error: any) {
    logTest('Test 5: Directory Publish - Get All Ranges', false, error.message);
  }
}

// Test 6: Authentication - Direct Query
async function testDirectQueryAuth() {
  const start = Date.now();
  try {
    const response = await axios.post(`${CP2_URL}/pstn2/v1/auth/verify`, {
      callerID: '+447123450000',
      calledID: '+447700900000',
      callReference: 'TEST-DQ-001',
      timestamp: new Date().toISOString()
    }, {
      headers: { 'X-From-CP': 'CP1-UK-0001' }
    });

    // Should verify successfully if caller is in database
    const valid = typeof response.data.verified === 'boolean';
    logTest('Test 6: Authentication - Direct Query', valid, undefined, Date.now() - start);
  } catch (error: any) {
    logTest('Test 6: Authentication - Direct Query', false, error.message);
  }
}

// Test 7: Authentication - Token Create (Token Pool)
async function testTokenCreate() {
  const start = Date.now();
  try {
    const response = await axios.post(`${CP3_URL}/pstn2/v1/auth/token/create`, {
      callerID: '+447777000000',
      validitySeconds: 300
    });

    const valid =
      response.data.token &&
      typeof response.data.token === 'string' &&
      response.data.expiresAt;

    logTest('Test 7: Token Pool - Create Token', valid, undefined, Date.now() - start);

    // Save token for next test
    if (valid) {
      (global as any).testToken = response.data.token;
    }
  } catch (error: any) {
    logTest('Test 7: Token Pool - Create Token', false, error.message);
  }
}

// Test 8: Authentication - Token Verify
async function testTokenVerify() {
  const start = Date.now();
  const token = (global as any).testToken;

  if (!token) {
    logTest('Test 8: Token Pool - Verify Token', false, 'No token from previous test');
    return;
  }

  try {
    const response = await axios.post(`${CP3_URL}/pstn2/v1/auth/token/verify`, {
      token,
      callerID: '+447777000000'
    });

    const valid = response.data.valid === true;
    logTest('Test 8: Token Pool - Verify Token', valid, undefined, Date.now() - start);
  } catch (error: any) {
    logTest('Test 8: Token Pool - Verify Token', false, error.message);
  }
}

// Test 9: Routing Request - Direct Routing
async function testRoutingRequest() {
  const start = Date.now();
  try {
    const response = await axios.post(`${CP2_URL}/pstn2/v1/routing/request`, {
      destinationNumber: '+447700900000',
      callerID: '+447123450000',
      callReference: 'TEST-RT-001',
      mediaCapabilities: {
        codecs: ['opus', 'g722'],
        encryption: ['srtp-aes256'],
        video: false
      },
      publicKey: 'TEST_PUBLIC_KEY'
    }, {
      headers: { 'X-From-CP': 'CP1-UK-0001' }
    });

    const valid = typeof response.data.accepted === 'boolean';
    logTest('Test 9: Direct Routing - Request', valid, undefined, Date.now() - start);
  } catch (error: any) {
    logTest('Test 9: Direct Routing - Request', false, error.message);
  }
}

// Test 10: Porting Query
async function testPortingQuery() {
  const start = Date.now();
  try {
    const response = await axios.post(`${CP1_URL}/pstn2/v1/porting/query`, {
      number: '+447123450000'
    });

    const valid = response.data.status && typeof response.data.status === 'string';
    logTest('Test 10: Porting - Query Status', valid, undefined, Date.now() - start);
  } catch (error: any) {
    logTest('Test 10: Porting - Query Status', false, error.message);
  }
}

// Test 11: Database Connection - CP1
async function testDatabaseCP1() {
  const start = Date.now();
  try {
    const response = await axios.get(`${CP1_URL}/pstn2/v1/info`);

    const valid =
      response.data.directoryStats &&
      typeof response.data.directoryStats.totalCPs === 'number';

    logTest('Test 11: Database - CP1 Data Access', valid, undefined, Date.now() - start);
  } catch (error: any) {
    logTest('Test 11: Database - CP1 Data Access', false, error.message);
  }
}

// Test 12: End-to-End Call Simulation (if simulator routes work)
async function testE2ECallSimulation() {
  const start = Date.now();
  try {
    const response = await axios.post(`${BASE_URL}/api/simulator/call/initiate`, {
      callerNumber: '+447123450000',
      calledNumber: '+447700900000',
      originatingCP: 'CP1-UK-0001',
      testDirectRouting: true
    });

    const valid =
      response.data.callReference &&
      response.data.success === true &&
      Array.isArray(response.data.messages);

    logTest('Test 12: E2E - Call Simulation', valid, undefined, Date.now() - start);
  } catch (error: any) {
    // This might fail if simulator routes aren't fully working
    logTest('Test 12: E2E - Call Simulation', false, error.message);
  }
}

// Test 13: CORS Headers
async function testCORS() {
  const start = Date.now();
  try {
    const response = await axios.options(`${CP1_URL}/pstn2/v1/info`, {
      headers: {
        'Origin': 'http://localhost:5173',
        'Access-Control-Request-Method': 'GET'
      }
    });

    const valid = response.status === 200 || response.status === 204;
    logTest('Test 13: CORS - Preflight Request', valid, undefined, Date.now() - start);
  } catch (error: any) {
    logTest('Test 13: CORS - Preflight Request', false, error.message);
  }
}

// Test 14: Error Handling - Invalid Request
async function testErrorHandling() {
  const start = Date.now();
  try {
    await axios.post(`${CP1_URL}/pstn2/v1/directory/query`, {
      // Missing required 'number' field
    });

    logTest('Test 14: Error Handling - Invalid Request', false, 'Should have thrown error');
  } catch (error: any) {
    const valid = error.response && (error.response.status === 400 || error.response.status === 500);
    logTest('Test 14: Error Handling - Invalid Request', valid, undefined, Date.now() - start);
  }
}

// Test 15: Media Capability Negotiation
async function testMediaCapabilities() {
  const start = Date.now();
  try {
    const response = await axios.post(`${CP2_URL}/pstn2/v1/routing/request`, {
      destinationNumber: '+447700900000',
      callerID: '+447123450000',
      callReference: 'TEST-MEDIA-001',
      mediaCapabilities: {
        codecs: ['opus', 'g711'],
        encryption: ['srtp-aes256', 'dtls'],
        video: true
      },
      publicKey: 'TEST_PUBLIC_KEY'
    }, {
      headers: { 'X-From-CP': 'CP1-UK-0001' }
    });

    // Should return accepted/rejected based on capability matching
    const valid = typeof response.data.accepted === 'boolean';
    logTest('Test 15: Media Capabilities - Negotiation', valid, undefined, Date.now() - start);
  } catch (error: any) {
    logTest('Test 15: Media Capabilities - Negotiation', false, error.message);
  }
}

// Main test runner
async function runAllTests() {
  console.log('\n' + '='.repeat(70));
  console.log('PSTN2 Test Harness - Integration Test Suite');
  console.log('='.repeat(70) + '\n');

  const startTime = Date.now();

  await testHealthChecks();
  await testCPInfo();
  await testDirectoryQuery();
  await testDirectoryQueryNotFound();
  await testDirectoryPublish();
  await testDirectQueryAuth();
  await testTokenCreate();
  await testTokenVerify();
  await testRoutingRequest();
  await testPortingQuery();
  await testDatabaseCP1();
  await testE2ECallSimulation();
  await testCORS();
  await testErrorHandling();
  await testMediaCapabilities();

  const totalTime = Date.now() - startTime;

  // Print summary
  console.log('\n' + '='.repeat(70));
  console.log('Test Summary');
  console.log('='.repeat(70));

  const passed = results.filter(r => r.passed).length;
  const failed = results.filter(r => !r.passed).length;
  const total = results.length;

  console.log(`\nTotal Tests: ${total}`);
  console.log(`✅ Passed: ${passed}`);
  console.log(`❌ Failed: ${failed}`);
  console.log(`⏱️  Total Time: ${totalTime}ms`);
  console.log(`📊 Success Rate: ${((passed / total) * 100).toFixed(1)}%`);

  if (failed > 0) {
    console.log('\n❌ Failed Tests:');
    results.filter(r => !r.passed).forEach(r => {
      console.log(`   - ${r.name}`);
      if (r.error) {
        console.log(`     ${r.error}`);
      }
    });
  }

  console.log('\n' + '='.repeat(70) + '\n');

  // Exit with appropriate code
  process.exit(failed > 0 ? 1 : 0);
}

// Run tests
runAllTests().catch(error => {
  console.error('Fatal error running tests:', error);
  process.exit(1);
});
